{
  "name": "@cyril-deschamps/expo-boilerplate",
  "version": "1.0.1",
  "author": "Cyril Deschamps <contact@cyrildeschamps.fr>",
  "description": "Best starter for Expo",
  "license": "MIT",
  "homepage": "https://github.com/Cyril-Deschamps/expo-boilerplate",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyril-Deschamps/expo-boilerplate.git"
  },
  "keywords": [
    "expo",
    "boilerplate",
    "typescript",
    "react",
    "native",
    "react-native",
    "eas"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint-check:react": "cross-env NODE_ENV=production && eslint src .eslintrc.js --max-warnings 0 --ext .tsx,.js,.ts",
    "lint-check:typing": "tsc --noEmit",
    "lint-check:prettier": "prettier --check src",
    "lint-fix:react": "cross-env NODE_ENV=production && eslint src .eslintrc.js --max-warnings 0 --ext .tsx,.js,.ts --fix",
    "lint-fix:prettier": "prettier --write src"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "axios": "^1.2.1",
    "date-fns": "^2.29.3",
    "expo": "^52.0.37",
    "expo-asset": "~11.0.4",
    "expo-constants": "~17.0.7",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@types/react": "^18.2.79",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "commitizen": "^4.2.6",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-deprecation": "^1.3.3",
    "eslint-plugin-react-native": "^4.0.0",
    "husky": "^8.0.2",
    "jest": "^29.3.1",
    "jest-expo": "~52.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.1",
    "react-test-renderer": "18.1.0",
    "typescript": "^5.3.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "preset": "jest-expo"
  }
}
